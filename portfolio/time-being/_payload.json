[{"data":1,"prerenderedAt":195},["ShallowReactive",2],{"portfolio-time-being":3},{"page":4,"next":173},{"id":5,"slug":6,"title":7,"displayTitle":8,"intro":9,"featuredMedia":10,"blocks":31},"Xvp1eLItTZ6RYi1Ls2SKIQ","time-being","Time Being","A Kinder Way to Track Time.","\u003Cp>\u003Cstrong>Time Being\u003C/strong> helps teams manage work time and well-being side by side, so leaders can understand both the hours worked and the human behind them.\u003C/p>",{"id":11,"media":12,"device":30},"GivOGx28RGKl9xKmCdOQfg",{"id":13,"alt":14,"title":14,"focalPoint":15,"width":17,"height":18,"thumbnail":19,"small":20,"medium":21,"responsiveImage":22,"video":14},"EiBHidzZRSyNGDOmDt7sDg",null,{"x":16,"y":16},0.5,1856,1085,"https://www.datocms-assets.com/163973/1780936052-tb_1-2.png?auto=format&fit=max&h=600&q=85&w=600","https://www.datocms-assets.com/163973/1780936052-tb_1-2.png?auto=format&fit=max&h=1000&q=85&w=1000","https://www.datocms-assets.com/163973/1780936052-tb_1-2.png?auto=format&fit=max&h=1500&q=85&w=1500",{"srcSet":23,"webpSrcSet":24,"sizes":25,"src":26,"width":17,"height":18,"aspectRatio":27,"alt":14,"title":14,"base64":28,"bgColor":29},"https://www.datocms-assets.com/163973/1780936052-tb_1-2.png?auto=format&dpr=0.25&fit=max&h=2440&q=85&w=2440 464w,https://www.datocms-assets.com/163973/1780936052-tb_1-2.png?auto=format&dpr=0.5&fit=max&h=2440&q=85&w=2440 928w,https://www.datocms-assets.com/163973/1780936052-tb_1-2.png?auto=format&dpr=0.75&fit=max&h=2440&q=85&w=2440 1392w,https://www.datocms-assets.com/163973/1780936052-tb_1-2.png?auto=format&fit=max&h=2440&q=85&w=2440 1856w","","(max-width: 1856px) 100vw, 1856px","https://www.datocms-assets.com/163973/1780936052-tb_1-2.png?auto=format&fit=max&h=2440&q=85&w=2440",1.7105990783410139,"data:image/jpeg;base64,","#db7b10","laptop",[32,94,149],{"id":33,"type":34,"device":30,"items":35},"OoIkNRfjTjOlzeSBA_8mpg","steps_block",[36,60,77],{"id":37,"media":38,"title":41,"subtitle":42,"text":43,"list":44,"link":56},"UW3GguOyQXa8kbHs0kopcw",{"id":13,"alt":14,"title":14,"focalPoint":39,"width":17,"height":18,"thumbnail":19,"small":20,"medium":21,"responsiveImage":40,"video":14},{"x":16,"y":16},{"srcSet":23,"webpSrcSet":24,"sizes":25,"src":26,"width":17,"height":18,"aspectRatio":27,"alt":14,"title":14,"base64":28,"bgColor":29},"Product Snapshot","What we built and why we built it.","\u003Cp class=\"isSelectedEnd\">\u003Cspan>Time Being is a time management platform designed to help organizations track work hours, projects, clients, approvals, utilization, and reporting while also surfacing patterns of overwork, stress, and burnout risk.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>Most time tracking tools are built to answer one question: how many hours were worked? Time Being asks a more useful follow-up: what are those hours doing to the people behind the work?\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>Taliyo Technologies created Time Being to bring time tracking and well-being into the same system. The platform includes Smart Time Entry, TimeSplit&trade;, BurnTrack&trade;, WellScore&trade;, Smart Nudges, Well-Being Mode, reporting, manager tools, and comfort and accessibility settings.\u003C/span>\u003C/p>\n\u003Cp>\u003Cspan>It is time tracking for the business, built with more care for the humans using it.\u003C/span>\u003C/p>",[45,48,52],{"id":46,"label":47,"text":7},"X6nsCFd-TcqUnY8i2SeUHg","Product Name:",{"id":49,"label":50,"text":51},"dhwSqMS5RC6pVQq9ogv2wg","Launched:","June 2026",{"id":53,"label":54,"text":55},"J41Rc7RLRlaOspNV2NjKMQ","Type:","Mental Health-Focused Timesheet App",{"id":57,"label":58,"internal":14,"external":59},"fQcehACYT32kmw26V8lHXw","Sign Up Today!","https://www.timebeing.app",{"id":61,"media":62,"title":73,"subtitle":74,"text":75,"list":76,"link":14},"Y0wmmjdlRkyIIgn4FkB_Kw",{"id":63,"alt":14,"title":14,"focalPoint":64,"width":17,"height":18,"thumbnail":65,"small":66,"medium":67,"responsiveImage":68,"video":14},"LLN3l38TQqKq5Cpm82ca_g",{"x":16,"y":16},"https://www.datocms-assets.com/163973/1780939737-bt.png?auto=format&fit=max&h=600&q=85&w=600","https://www.datocms-assets.com/163973/1780939737-bt.png?auto=format&fit=max&h=1000&q=85&w=1000","https://www.datocms-assets.com/163973/1780939737-bt.png?auto=format&fit=max&h=1500&q=85&w=1500",{"srcSet":69,"webpSrcSet":24,"sizes":25,"src":70,"width":17,"height":18,"aspectRatio":27,"alt":14,"title":14,"base64":71,"bgColor":72},"https://www.datocms-assets.com/163973/1780939737-bt.png?auto=format&dpr=0.25&fit=max&h=2440&q=85&w=2440 464w,https://www.datocms-assets.com/163973/1780939737-bt.png?auto=format&dpr=0.5&fit=max&h=2440&q=85&w=2440 928w,https://www.datocms-assets.com/163973/1780939737-bt.png?auto=format&dpr=0.75&fit=max&h=2440&q=85&w=2440 1392w,https://www.datocms-assets.com/163973/1780939737-bt.png?auto=format&fit=max&h=2440&q=85&w=2440 1856w","https://www.datocms-assets.com/163973/1780939737-bt.png?auto=format&fit=max&h=2440&q=85&w=2440","data:image/jpeg;base64,","#d97708","The Spark.","If companies track time, they should care what that time is doing to people.","\u003Cp class=\"isSelectedEnd\">\u003Cspan>Timesheets are necessary for a lot of organizations. Teams need hours for billing, staffing, payroll, forecasting, utilization, and planning. But the tools used to collect that time often ignore the person entering it.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>Every Friday, people sit down, guess what they worked on, submit the sheet, and move on. Managers get numbers. Leaders get reports. But very few people get a clearer understanding of whether the work is healthy, sustainable, or quietly pushing teams toward burnout.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>That disconnect became the spark for Time Being.\u003C/span>\u003C/p>\n\u003Cp>\u003Cspan>Instead of trying to eliminate timesheets, we asked what they could become if they were designed to be useful for employees, managers, and leaders at the same time.\u003C/span>\u003C/p>",[],{"id":78,"media":79,"title":90,"subtitle":91,"text":92,"list":93,"link":14},"C4MNrMIAR1WuHGeSOcZDgg",{"id":80,"alt":14,"title":14,"focalPoint":81,"width":17,"height":18,"thumbnail":82,"small":83,"medium":84,"responsiveImage":85,"video":14},"DfbtCSPfQ92VuGWPt4RYOA",{"x":16,"y":16},"https://www.datocms-assets.com/163973/1780939404-dark-2.png?auto=format&fit=max&h=600&q=85&w=600","https://www.datocms-assets.com/163973/1780939404-dark-2.png?auto=format&fit=max&h=1000&q=85&w=1000","https://www.datocms-assets.com/163973/1780939404-dark-2.png?auto=format&fit=max&h=1500&q=85&w=1500",{"srcSet":86,"webpSrcSet":24,"sizes":25,"src":87,"width":17,"height":18,"aspectRatio":27,"alt":14,"title":14,"base64":88,"bgColor":89},"https://www.datocms-assets.com/163973/1780939404-dark-2.png?auto=format&dpr=0.25&fit=max&h=2440&q=85&w=2440 464w,https://www.datocms-assets.com/163973/1780939404-dark-2.png?auto=format&dpr=0.5&fit=max&h=2440&q=85&w=2440 928w,https://www.datocms-assets.com/163973/1780939404-dark-2.png?auto=format&dpr=0.75&fit=max&h=2440&q=85&w=2440 1392w,https://www.datocms-assets.com/163973/1780939404-dark-2.png?auto=format&fit=max&h=2440&q=85&w=2440 1856w","https://www.datocms-assets.com/163973/1780939404-dark-2.png?auto=format&fit=max&h=2440&q=85&w=2440","data:image/jpeg;base64,","#ea3f41","The Problem.","The hours mattered. The human impact was missing.","\u003Cp class=\"isSelectedEnd\">\u003Cspan>Traditional time tracking software is usually built around control, compliance, and reporting. It can tell a company how many hours were worked, but not whether those hours came with late nights, skipped breaks, weekend work, rising stress, or repeated overwork.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>That creates a dangerous blind spot. A 42-hour week might be perfectly healthy. A 42-hour week after three late nights and no recovery time might be a warning sign.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>Most systems treat those weeks the same.\u003C/span>\u003C/p>\n\u003Cp>\u003Cspan>Time Being needed to keep the operational value of time tracking while adding the human context that traditional tools leave out.\u003C/span>\u003C/p>",[],{"id":95,"type":96,"title":97,"subtitle":98,"text1":99,"text2":100,"media":101},"IVwRyj5sTTO3n5mx--lh1Q","image_grid_block","The Process.","From “how many hours?” to “is this sustainable?”","\u003Cp dir=\"ltr\">Product strategy started with a clear tension: companies need time data, but employees need the experience to feel less frustrating, less extractive, and more useful.\u003C/p>","\u003Cp class=\"isSelectedEnd\">\u003Cspan>So we designed Time Being around two connected layers. The first layer handles the practical work of time management: timers, entries, clients, projects, tasks, approvals, reporting, utilization, and dashboards. The second layer looks at the well-being patterns that emerge from the way time is actually worked.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>That meant building features that make time easier to capture, like Smart Time Entry and TimeSplit&trade;, while also creating signals that help people understand the broader story behind the hours.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>BurnTrack&trade; was designed to flag patterns of overwork and burnout risk. WellScore&trade; helps show how work may be affecting well-being over time. Smart Nudges give employees and managers earlier prompts to pause, check in, or pay attention before a pattern becomes a problem.\u003C/span>\u003C/p>\n\u003Cp>\u003Cspan>Just as important, Time Being was intentionally designed without keystroke tracking, mouse monitoring, website tracking, or creepy productivity scoring. The goal was never surveillance. The goal was shared visibility, healthier conversations, and earlier action.\u003C/span>\u003C/p>",[102,119,134],{"id":103,"alt":14,"title":14,"focalPoint":104,"width":105,"height":106,"thumbnail":107,"small":108,"medium":109,"responsiveImage":110,"video":14},"TtLEaL87TNKhcQtrkRShzg",{"x":16,"y":16},4880,2138,"https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&fit=max&h=600&q=85&w=600","https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&fit=max&h=1000&q=85&w=1000","https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&fit=max&h=1500&q=85&w=1500",{"srcSet":111,"webpSrcSet":24,"sizes":112,"src":113,"width":114,"height":115,"aspectRatio":116,"alt":14,"title":14,"base64":117,"bgColor":118},"https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&dpr=0.25&fit=max&h=2440&q=85&w=2440 610w,https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&dpr=0.5&fit=max&h=2440&q=85&w=2440 1220w,https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&dpr=0.75&fit=max&h=2440&q=85&w=2440 1830w,https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&fit=max&h=2440&q=85&w=2440 2440w,https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&dpr=1.5&fit=max&h=2440&q=85&w=2440 3660w,https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&dpr=2&fit=max&h=2440&q=85&w=2440 4880w","(max-width: 2440px) 100vw, 2440px","https://www.datocms-assets.com/163973/1780937047-frame-8.png?auto=format&fit=max&h=2440&q=85&w=2440",2440,1069,2.2825070159027128,"data:image/jpeg;base64,","#3d6181",{"id":120,"alt":14,"title":14,"focalPoint":121,"width":122,"height":123,"thumbnail":124,"small":125,"medium":126,"responsiveImage":127,"video":14},"Lxd93Xf3TmGjEpHc6Ca1OQ",{"x":16,"y":16},1882,2316,"https://www.datocms-assets.com/163973/1780937043-frame-9.png?auto=format&fit=max&h=600&q=85&w=600","https://www.datocms-assets.com/163973/1780937043-frame-9.png?auto=format&fit=max&h=1000&q=85&w=1000","https://www.datocms-assets.com/163973/1780937043-frame-9.png?auto=format&fit=max&h=1500&q=85&w=1500",{"srcSet":128,"webpSrcSet":24,"sizes":129,"src":130,"width":122,"height":123,"aspectRatio":131,"alt":14,"title":14,"base64":132,"bgColor":133},"https://www.datocms-assets.com/163973/1780937043-frame-9.png?auto=format&dpr=0.25&fit=max&h=2440&q=85&w=2440 470w,https://www.datocms-assets.com/163973/1780937043-frame-9.png?auto=format&dpr=0.5&fit=max&h=2440&q=85&w=2440 941w,https://www.datocms-assets.com/163973/1780937043-frame-9.png?auto=format&dpr=0.75&fit=max&h=2440&q=85&w=2440 1411w,https://www.datocms-assets.com/163973/1780937043-frame-9.png?auto=format&fit=max&h=2440&q=85&w=2440 1882w","(max-width: 1882px) 100vw, 1882px","https://www.datocms-assets.com/163973/1780937043-frame-9.png?auto=format&fit=max&h=2440&q=85&w=2440",0.812607944732297,"data:image/jpeg;base64,","#ef4345",{"id":135,"alt":14,"title":14,"focalPoint":136,"width":137,"height":138,"thumbnail":139,"small":140,"medium":141,"responsiveImage":142,"video":14},"KeQtfogyQrWObfMrX_8Ijw",{"x":16,"y":16},1580,1158,"https://www.datocms-assets.com/163973/1780939946-ai.png?auto=format&fit=max&h=600&q=85&w=600","https://www.datocms-assets.com/163973/1780939946-ai.png?auto=format&fit=max&h=1000&q=85&w=1000","https://www.datocms-assets.com/163973/1780939946-ai.png?auto=format&fit=max&h=1500&q=85&w=1500",{"srcSet":143,"webpSrcSet":24,"sizes":144,"src":145,"width":137,"height":138,"aspectRatio":146,"alt":14,"title":14,"base64":147,"bgColor":148},"https://www.datocms-assets.com/163973/1780939946-ai.png?auto=format&dpr=0.25&fit=max&h=2440&q=85&w=2440 395w,https://www.datocms-assets.com/163973/1780939946-ai.png?auto=format&dpr=0.5&fit=max&h=2440&q=85&w=2440 790w,https://www.datocms-assets.com/163973/1780939946-ai.png?auto=format&dpr=0.75&fit=max&h=2440&q=85&w=2440 1185w,https://www.datocms-assets.com/163973/1780939946-ai.png?auto=format&fit=max&h=2440&q=85&w=2440 1580w","(max-width: 1580px) 100vw, 1580px","https://www.datocms-assets.com/163973/1780939946-ai.png?auto=format&fit=max&h=2440&q=85&w=2440",1.3644214162348878,"data:image/jpeg;base64,","#3c6081",{"id":150,"type":151,"title":152,"subtitle":153,"text":154,"media":155,"reverse":172},"D7vXgCpbTGGMFglIyfhnZw","text_device_block","The Solve.","Time tracking that works for the business and the people doing the work.","\u003Cp class=\"isSelectedEnd\">\u003Cspan>Time Being brings work time and well-being into one platform.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>Teams can track hours, manage clients and projects, submit and approve timesheets, review utilization, and generate reporting. Employees can log time faster with AI-assisted and voice-powered entry. TimeSplit&trade; lets people move between tasks without constantly stopping and restarting their timer.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>At the same time, the platform helps teams spot the patterns that usually stay hidden. BurnTrack&trade; surfaces overwork risk. WellScore&trade; gives people a clearer view of how work is trending. Smart Nudges help managers know when to check in. Well-Being Mode gives employees a calmer space to pause, breathe, and reset during the day.\u003C/span>\u003C/p>\n\u003Cp class=\"isSelectedEnd\">\u003Cspan>The result is a time management platform that does more than collect hours.\u003C/span>\u003C/p>\n\u003Cp>\u003Cspan>It helps organizations understand the work, support the people doing it, and make burnout harder to ignore.\u003C/span>\u003C/p>",{"id":156,"media":157,"device":30},"LL6mkbd1RjWv938OtgrjVw",{"id":158,"alt":14,"title":14,"focalPoint":159,"width":160,"height":161,"thumbnail":162,"small":163,"medium":164,"responsiveImage":165,"video":14},"MNSjiafIQnm3XTfxMNEYFw",{"x":16,"y":16},2858,1672,"https://www.datocms-assets.com/163973/1756814206-tb_dash.png?auto=format&fit=max&h=600&q=85&w=600","https://www.datocms-assets.com/163973/1756814206-tb_dash.png?auto=format&fit=max&h=1000&q=85&w=1000","https://www.datocms-assets.com/163973/1756814206-tb_dash.png?auto=format&fit=max&h=1500&q=85&w=1500",{"srcSet":166,"webpSrcSet":24,"sizes":112,"src":167,"width":114,"height":168,"aspectRatio":169,"alt":14,"title":14,"base64":170,"bgColor":171},"https://www.datocms-assets.com/163973/1756814206-tb_dash.png?auto=format&dpr=0.25&fit=max&h=2440&q=85&w=2440 610w,https://www.datocms-assets.com/163973/1756814206-tb_dash.png?auto=format&dpr=0.5&fit=max&h=2440&q=85&w=2440 1220w,https://www.datocms-assets.com/163973/1756814206-tb_dash.png?auto=format&dpr=0.75&fit=max&h=2440&q=85&w=2440 1830w,https://www.datocms-assets.com/163973/1756814206-tb_dash.png?auto=format&fit=max&h=2440&q=85&w=2440 2440w","https://www.datocms-assets.com/163973/1756814206-tb_dash.png?auto=format&fit=max&h=2440&q=85&w=2440",1427,1.7093301435406698,"data:image/jpeg;base64,","#71be46",false,{"id":174,"slug":175,"title":176,"featuredMedia":177},"D5CqpIg_RA-DNsC_w4P5Iw","vital-access","Vital Access",{"id":178,"media":179,"device":194},"Rp5KiVCsTxyxuSHaLX8PBg",{"id":180,"alt":14,"title":14,"focalPoint":181,"width":182,"height":183,"thumbnail":184,"small":185,"medium":186,"responsiveImage":187,"video":14},"AVllGn5ESNey_EsZKs3b6Q",{"x":16,"y":16},1338,1003,"https://www.datocms-assets.com/163973/1756780022-va_dc.png?auto=format&fit=max&h=600&q=85&w=600","https://www.datocms-assets.com/163973/1756780022-va_dc.png?auto=format&fit=max&h=1000&q=85&w=1000","https://www.datocms-assets.com/163973/1756780022-va_dc.png?auto=format&fit=max&h=1500&q=85&w=1500",{"srcSet":188,"webpSrcSet":24,"sizes":189,"src":190,"width":182,"height":183,"aspectRatio":191,"alt":14,"title":14,"base64":192,"bgColor":193},"https://www.datocms-assets.com/163973/1756780022-va_dc.png?auto=format&dpr=0.25&fit=max&h=2440&q=85&w=2440 334w,https://www.datocms-assets.com/163973/1756780022-va_dc.png?auto=format&dpr=0.5&fit=max&h=2440&q=85&w=2440 669w,https://www.datocms-assets.com/163973/1756780022-va_dc.png?auto=format&dpr=0.75&fit=max&h=2440&q=85&w=2440 1003w,https://www.datocms-assets.com/163973/1756780022-va_dc.png?auto=format&fit=max&h=2440&q=85&w=2440 1338w","(max-width: 1338px) 100vw, 1338px","https://www.datocms-assets.com/163973/1756780022-va_dc.png?auto=format&fit=max&h=2440&q=85&w=2440",1.3339980059820538,"data:image/png;base64,","#26507d","tablet",1780997620010]